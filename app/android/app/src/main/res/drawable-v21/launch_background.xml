<?xml version="1.0" encoding="utf-8"?>
<!-- Lo que se ve mientras Flutter arranca. Antes era un rectángulo blanco:
     el placeholder que deja `flutter create`. Ahora es el mismo emblema sobre
     el mismo crema que la splash de iOS. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/crema" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
