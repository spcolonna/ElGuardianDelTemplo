  "comic": [
    {
      "clave": "intro",
      "disparo": "Antes de empezar la partida.",
      "paneles": [
        {
          "archivo": "01_templo_amanecer.png",
          "narracion": "High on the mountain, where the wind complains and the tea is never quite hot enough, stands the Temple of the Crooked Lotus.",
          "dichos": [
            {
              "quien": "",
              "texto": "(One hundred and eight steps up to the gate.)",
              "acotacion": true
            },
            {
              "quien": "",
              "texto": "(The Rookie sweeps them every morning. Every morning they get dirty again.)",
              "acotacion": true
            }
          ]
        },
        {
          "archivo": "02_shifu_se_va.png",
          "narracion": "This morning, Grandmaster Shifu left for the Annual Congress of Martial Arts Masters and Jasmine Tea.",
          "dichos": [
            {
              "quien": "Shifu",
              "texto": "Back in seven days. I trust you.",
              "acotacion": false
            },
            {
              "quien": "Rookie",
              "texto": "Seven days on my own?",
              "acotacion": false
            },
            {
              "quien": "Shifu",
              "texto": "Not on your own. Mei is here.",
              "acotacion": false
            },
            {
              "quien": "",
              "texto": "(Mei had already gone to sleep.)",
              "acotacion": true
            }
          ]
        },
        {
          "archivo": "03_la_nota.png",
          "narracion": "Before leaving he left a note, in flawless calligraphy.",
          "dichos": [
            {
              "quien": "The note",
              "texto": "Dear rookie: don't burn the temple down. Don't eat the cookies in the cupboard (they are mine). Sweep the courtyard every morning.",
              "acotacion": false
            },
            {
              "quien": "The note",
              "texto": "And above all: DO NOT LET STRANGERS IN.",
              "acotacion": false
            },
            {
              "quien": "Rookie",
              "texto": "Easy.",
              "acotacion": false
            }
          ]
        },
        {
          "archivo": "04_posdata.png",
          "narracion": "And below, in smaller letters, a postscript.",
          "dichos": [
            {
              "quien": "The note",
              "texto": "P.S.: If anyone asks about the \"Great Illegal Martial Arts Tournament\", tell them we firmly declined.",
              "acotacion": false
            },
            {
              "quien": "Rookie",
              "texto": "The what?",
              "acotacion": false
            },
            {
              "quien": "Rookie",
              "texto": "We declined WHAT?",
              "acotacion": false
            }
          ]
        },
        {
          "archivo": "05_llegan_los_problemas.png",
          "narracion": "Shifu rounded the first bend in the road. Twelve seconds later, they started climbing.",
          "dichos": [
            {
              "quien": "Rookie",
              "texto": "Well. That escalated fast.",
              "acotacion": false
            },
            {
              "quien": "",
              "texto": "(There were fourteen of them, to begin with.)",
              "acotacion": true
            }
          ]
        },
        {
          "archivo": "06_tentaciones.png",
          "narracion": "And the worst of it wasn't coming from outside.",
          "dichos": [
            {
              "quien": "Rookie",
              "texto": "One cookie is not going to show.",
              "acotacion": false
            },
            {
              "quien": "Rookie",
              "texto": "He didn't count them. No way he counted them.",
              "acotacion": false
            },
            {
              "quien": "",
              "texto": "(Shifu had counted them.)",
              "acotacion": true
            }
          ]
        },
        {
          "archivo": "07_entrenamiento.png",
          "narracion": "The day is only starting. You will train with whatever shows up, and turn every beating into a new technique.",
          "dichos": [
            {
              "quien": "",
              "texto": "(Dawn. Noon. Dusk.)",
              "acotacion": true
            },
            {
              "quien": "",
              "texto": "(Three times the mountain gets climbed, and each time by something worse.)",
              "acotacion": true
            },
            {
              "quien": "Rookie",
              "texto": "I can do this.",
              "acotacion": false
            }
          ]
        },
        {
          "archivo": "08_campeones.png",
          "narracion": "And once the sun sinks behind the mountain, two Tournament Champions will knock on the gate to take the temple.",
          "dichos": [
            {
              "quien": "Rookie",
              "texto": "Can I protect the temple?",
              "acotacion": false
            },
            {
              "quien": "Rookie",
              "texto": "And Shifu's cookies?",
              "acotacion": false
            },
            {
              "quien": "",
              "texto": "(One of those two answers was going to be no.)",
              "acotacion": true
            }
          ]
        }
      ]
    },
    {
      "clave": "mediodia",
      "disparo": "Cuando se acaba el mazo del Alba.",
      "paneles": [
        {
          "archivo": "10_fin_alba.png",
          "narracion": "You held the Dawn. Everything hurts, but you are still standing and the courtyard is still yours.",
          "dichos": [
            {
              "quien": "Rookie",
              "texto": "One down.",
              "acotacion": false
            },
            {
              "quien": "",
              "texto": "(The sun was only just climbing.)",
              "acotacion": true
            }
          ]
        },
        {
          "archivo": "11_mei_juzga.png",
          "narracion": "Mei, the guardian cat, reviewed your performance from the roof. She was not impressed.",
          "dichos": [
            {
              "quien": "Mei",
              "texto": "(devastating feline silence)",
              "acotacion": true
            },
            {
              "quien": "Rookie",
              "texto": "I won, you know.",
              "acotacion": false
            },
            {
              "quien": "Mei",
              "texto": "(slow blink)",
              "acotacion": true
            },
            {
              "quien": "Rookie",
              "texto": "Fine. I tied.",
              "acotacion": false
            }
          ]
        },
        {
          "archivo": "12_llega_tao.png",
          "narracion": "By Noon the curious have stopped climbing. Now it is the ones who get paid to be here.",
          "dichos": [
            {
              "quien": "Tao",
              "texto": "Not bad for someone who couldn't make a fist this morning.",
              "acotacion": false
            },
            {
              "quien": "Tao",
              "texto": "The ones at this hour hit different, though.",
              "acotacion": false
            },
            {
              "quien": "Rookie",
              "texto": "And whose side are you on?",
              "acotacion": false
            },
            {
              "quien": "Tao",
              "texto": "The winning one.",
              "acotacion": false
            }
          ]
        }
      ]
    },
    {
      "clave": "ocaso",
      "disparo": "Cuando se acaba el mazo del Mediodía.",
      "paneles": [
        {
          "archivo": "20_fin_mediodia.png",
          "narracion": "Noon left your hands raw, but the gate never opened for anyone you didn't want in.",
          "dichos": [
            {
              "quien": "Rookie",
              "texto": "Two.",
              "acotacion": false
            },
            {
              "quien": "",
              "texto": "(The shadows in the courtyard were already stretching.)",
              "acotacion": true
            }
          ]
        },
        {
          "archivo": "21_traicion_tao.png",
          "narracion": "Tao left as the sun started going down. He did not say goodbye.",
          "dichos": [
            {
              "quien": "Rookie",
              "texto": "Ah. So that was it.",
              "acotacion": false
            },
            {
              "quien": "Tao",
              "texto": "The winning one, kid. I told you up front.",
              "acotacion": false
            }
          ]
        },
        {
          "archivo": "22_cae_la_noche.png",
          "narracion": "At Dusk the bandits stop climbing: bandits are afraid of the mountain in the dark too. Something else climbs.",
          "dichos": [
            {
              "quien": "",
              "texto": "(The shadows in the courtyard stopped matching the courtyard.)",
              "acotacion": true
            },
            {
              "quien": "Rookie",
              "texto": "There is nobody there.",
              "acotacion": false
            },
            {
              "quien": "Rookie",
              "texto": "There is nobody there.",
              "acotacion": false
            }
          ]
        }
      ]
    },
    {
      "clave": "jefes",
      "disparo": "Cuando se acaba el mazo del Ocaso.",
      "paneles": [
        {
          "archivo": "30_fin_ocaso.png",
          "narracion": "You held the whole Dusk, the ones wearing your face included. The mountain went quiet.",
          "dichos": [
            {
              "quien": "Rookie",
              "texto": "It is over.",
              "acotacion": false
            },
            {
              "quien": "",
              "texto": "(It was not over.)",
              "acotacion": true
            }
          ]
        },
        {
          "archivo": "31_golpean_el_porton.png",
          "narracion": "Three knocks on the gate. Not one of them asked permission.",
          "dichos": [
            {
              "quien": "",
              "texto": "(One.)",
              "acotacion": true
            },
            {
              "quien": "",
              "texto": "(Two.)",
              "acotacion": true
            },
            {
              "quien": "",
              "texto": "(Three.)",
              "acotacion": true
            },
            {
              "quien": "Rookie",
              "texto": "All right. Come in.",
              "acotacion": false
            }
          ]
        },
        {
          "archivo": "32_los_campeones.png",
          "narracion": "The Great Illegal Martial Arts Tournament needs a venue. They came for yours.",
          "dichos": [
            {
              "quien": "The Champions",
              "texto": "We were told nobody was here.",
              "acotacion": false
            },
            {
              "quien": "Rookie",
              "texto": "You were told wrong.",
              "acotacion": false
            }
          ]
        }
      ]
    },
    {
      "clave": "victoria",
      "disparo": "Cuando derrotás al último jefe.",
      "paneles": [
        {
          "archivo": "40_victoria_campeones.png",
          "narracion": "Both Champions left the way they came. One of them limping.",
          "dichos": [
            {
              "quien": "Rookie",
              "texto": "The temple is not for sale.",
              "acotacion": false
            },
            {
              "quien": "",
              "texto": "(Mei came down from the roof for the first time all day.)",
              "acotacion": true
            }
          ]
        },
        {
          "archivo": "41_vuelve_shifu.png",
          "narracion": "When the deadline was up, Shifu came back. Same hat, same bag, same face.",
          "dichos": [
            {
              "quien": "Shifu",
              "texto": "The courtyard is swept. The temple stands. Good.",
              "acotacion": false
            },
            {
              "quien": "Rookie",
              "texto": "It was quiet.",
              "acotacion": false
            },
            {
              "quien": "Shifu",
              "texto": "Mm.",
              "acotacion": false
            }
          ]
        },
        {
          "archivo": "42_las_galletas.png",
          "narracion": "Then he opened the cupboard.",
          "dichos": [
            {
              "quien": "Shifu",
              "texto": "Two are missing.",
              "acotacion": false
            },
            {
              "quien": "Rookie",
              "texto": "Mei.",
              "acotacion": false
            },
            {
              "quien": "Mei",
              "texto": "(was no longer in frame)",
              "acotacion": true
            }
          ]
        }
      ]
    },
    {
      "clave": "derrota",
      "disparo": "Cuando tu Energía baja de 0, en CUALQUIER fase.",
      "paneles": [
        {
          "archivo": "50_derrota_patio.png",
          "narracion": "You have nothing left. No Energy, no techniques, no excuses.",
          "dichos": [
            {
              "quien": "",
              "texto": "(The gate stayed open. Nobody closed it.)",
              "acotacion": true
            }
          ]
        },
        {
          "archivo": "51_shifu_ve_el_desastre.png",
          "narracion": "Shifu came back on time, as always.",
          "dichos": [
            {
              "quien": "Shifu",
              "texto": "...",
              "acotacion": false
            },
            {
              "quien": "Rookie",
              "texto": "I can explain.",
              "acotacion": false
            },
            {
              "quien": "Shifu",
              "texto": "...",
              "acotacion": false
            }
          ]
        },
        {
          "archivo": "52_la_pregunta.png",
          "narracion": "And then he asked the only question that mattered.",
          "dichos": [
            {
              "quien": "Shifu",
              "texto": "And the cookies?",
              "acotacion": false
            },
            {
              "quien": "",
              "texto": "(That was the hard part to explain.)",
              "acotacion": true
            }
          ]
        }
      ]
    }
  ]
